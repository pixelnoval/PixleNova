# Environment — copy this file to .env and fill in your values
# Never commit .env to version control

# ─── DATABASE ────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string (Supabase / Render / Railway / local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
# Direct URL needed for Prisma migrations on connection-pooled hosts (e.g. Supabase pgBouncer)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ─── SERVER ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────────────────────
# Frontend origin — no trailing slash
FRONTEND_URL=http://localhost:5173

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_very_long_random_jwt_secret_here_minimum_64_chars
JWT_EXPIRES_IN=7d

# ─── EMAIL ───────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM="PixleNova <no-reply@pixlenova.com>"
# Where admin enquiry notifications are sent
ADMIN_EMAIL=admin@pixlenova.com

# ─── ADMIN SEED ──────────────────────────────────────────────────────────────
# Used only for the one-time seed script — change after first login
ADMIN_EMAIL_SEED=admin@pixlenova.com
ADMIN_PASSWORD_SEED=ChangeThisPasswordImmediately!
